{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"seed": "ts-node --require tsconfig-paths/register ./src/users/seeds/role.seed.ts",
		"dev": "nest start --watch --preserveWatchOutput",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"ts:check": "tsc --noEmit",
		"test": "jest",
		"typeorm": "typeorm-ts-node-commonjs",
		"migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/core/typeorm-config.ts",
		"migration:run": "typeorm-ts-node-commonjs migration:run -d src/core/typeorm-config.ts",
		"migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/core/typeorm-config.ts",
		"migration:show": "typeorm-ts-node-commonjs migration:show -d src/core/typeorm-config.ts",
		"migration:verify": "ts-node scripts/verify-migration.ts",
		"migration:backup": "ts-node scripts/backup-before-migration.ts",
		"demo:reset": "curl -X POST http://localhost:3000/demo/reset",
		"demo:seed": "curl -X POST http://localhost:3000/demo/seed",
		"demo:status": "curl -X GET http://localhost:3000/demo/status"
	},
	"dependencies": {
		"@nestjs-modules/mailer": "^2.0.2",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/mapped-types": "*",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/schedule": "^6.0.1",
		"@nestjs/typeorm": "^11.0.0",
		"@repo/common": "workspace:*",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.2",
		"class-transformer": "^0.5.1",
		"cookie-parser": "^1.4.7",
		"crypto": "^1.0.1",
		"dotenv": "^16.4.7",
		"passport-jwt": "^4.0.1",
		"pg": "^8.14.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"sqlite3": "^5.1.7",
		"typeorm": "^0.3.21"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/swagger": "^11.1.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": ["js", "json", "ts"],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": ["**/*.(t|j)s"],
		"testTimeout": 60000,
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
